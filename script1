"""Tests for original FileKit commands (v0.1 compat)."""

import sys
sys.path.insert(0, "/home/claude/filekit")

import pytest
from pathlib import Path
from filekit.utils import human_size, compute_hash, collect_files


def test_human_size_bytes():
    assert human_size(512) == "512.00 B"

def test_human_size_kb():
    assert "KB" in human_size(2048)

def test_human_size_mb():
    assert "MB" in human_size(2 * 1024 * 1024)

def test_compute_hash(tmp_path):
    f = tmp_path / "file.txt"
    f.write_bytes(b"hello")
    digest = compute_hash(f, "sha256")
    assert len(digest) == 64

def test_compute_hash_md5(tmp_path):
    f = tmp_path / "file.txt"
    f.write_bytes(b"hello")
    digest = compute_hash(f, "md5")
    assert len(digest) == 32

def test_collect_files(tmp_path):
    (tmp_path / "a.txt").write_text("a")
    (tmp_path / "b.txt").write_text("b")
    sub = tmp_path / "sub"
    sub.mkdir()
    (sub / "c.txt").write_text("c")
    files = list(collect_files(tmp_path, recursive=True))
    assert len(files) == 3

def test_collect_files_non_recursive(tmp_path):
    (tmp_path / "a.txt").write_text("a")
    sub = tmp_path / "sub"
    sub.mkdir()
    (sub / "b.txt").write_text("b")
    files = list(collect_files(tmp_path, recursive=False))
    assert len(files) == 1
